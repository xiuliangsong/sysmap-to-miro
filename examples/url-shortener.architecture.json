    { "id": "api",      "type": "cloud",      "label": "Public API",         "sublabel": "API Gateway + WAF",     "pos": [250, 280], "size": [150, 60], "tag": "POST /links · GET /{code}" },
    { "id": "create",   "type": "backend",    "label": "Create-link fn",     "sublabel": "Lambda",                "pos": [470, 200], "size": [150, 60] },
    { "id": "resolve",  "type": "backend",    "label": "Redirect resolver",  "sublabel": "Lambda",                "pos": [470, 360], "size": [150, 60] },
    { "id": "cache",    "type": "database",   "label": "Hot-link cache",     "sublabel": "DynamoDB DAX",          "pos": [690, 120], "size": [150, 60] },
    { "id": "links",    "type": "database",   "label": "Links table",        "sublabel": "DynamoDB",              "pos": [690, 280], "size": [150, 60] },
    { "id": "notify",   "type": "cloud",      "label": "Quota alerts",       "sublabel": "SES email",             "pos": [470, 520], "size": [150, 60] },
    { "id": "clickq",   "type": "messagebus", "label": "Click events",       "sublabel": "SQS queue",             "pos": [690, 440], "size": [150, 60] },
    { "id": "agg",      "type": "backend",    "label": "Click aggregator",   "sublabel": "Lambda",                "pos": [910, 440], "size": [150, 60] },
    { "id": "stream",   "type": "messagebus", "label": "Delivery stream",    "sublabel": "Kinesis Firehose",      "pos": [1130, 440], "size": [150, 60] },
    { "id": "lake",     "type": "database",   "label": "Analytics data",     "sublabel": "S3 bucket",             "pos": [1130, 580], "size": [150, 60] }
